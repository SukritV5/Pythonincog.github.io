    if key == "Anchored" then
        -- Store the 'value' for the 'Anchored' property in our custom table
        customAnchoredStates[self] = value
        return
    end

    -- If the key is not 'Anchored', use the original __newindex
    if old_nv_newindex then
        old_nv_newindex(self, key, value)
    else
        -- Default Lua behavior: set the property directly on the table (though for Instances,
        -- this usually means setting a Roblox-defined property)
        rawset(self, key, value)
    end
end

